# mako notification config — warm monochrome palette
font=JetBrains Mono 12
format=<b>%a</b> · %s\n%b
sort=-time
output=eDP-1
layer=overlay
anchor=top-right

# geometry
width=380
margin=12
padding=14,16
border-size=1
border-radius=0

# base colors (warm)
background-color=#0b0a08ee
text-color=#e8e0d4
border-color=#3e372c

# icons
icons=0
max-icon-size=32

# timing
default-timeout=4000
ignore-timeout=1

# text
text-alignment=left
markup=1
actions=1
history=1
max-history=5

# -------------------------------------------------------
# urgency levels
# -------------------------------------------------------
[urgency=low]
background-color=#0b0a08cc
border-color=#2e2a24
text-color=#a89e8e
default-timeout=5000

[urgency=normal]
background-color=#0b0a08ee
border-color=#3e372c
text-color=#e8e0d4
default-timeout=1000

[urgency=high]
background-color=#0b0a08
border-color=#e0847b
text-color=#e8e0d4
default-timeout=0

# -------------------------------------------------------
# app-specific overrides
# -------------------------------------------------------
[app-name="lightcord"]
background-color=#0b0a08ee
border-color=#7a95c9
text-color=#e8e0d4

[summary~="^log-.*"]
border-color=#8fd19e
text-color=#8fd19e

[app-name="discord"]
border-color=#7a95c9

[app-name="spotify"]
border-color=#9bb37d

[app-name="playerctl"]
border-color=#b39ddb

# silent/suppress rules
[app-name="lightcord" summary~="(orz|ORZ|sto|STO|otl|OTL)"]
invisible=1
