font=JetBrains Mono 12
format=<span foreground="#000000" background="#ffffff"><b> %a </b></span> <b>%s</b>\n<span foreground="#ffffff">%b</span>
sort=-time
output=eDP-1
layer=overlay
anchor=top-right
width=380
margin=12
padding=14,16
border-size=2
border-radius=0
background-color=#000000f5
text-color=#ffffff
border-color=#bfbfbf
icons=0
max-icon-size=32
default-timeout=4000
ignore-timeout=1
text-alignment=left
markup=1
actions=1
history=1
max-history=5

[urgency=low]
background-color=#080808f2
border-color=#555555
text-color=#b0b0b0
default-timeout=5000
format=<span foreground="#080808" background="#8a8a8a"><b> %a </b></span> <b>%s</b>\n%b

[urgency=normal]
background-color=#000000f5
border-color=#bfbfbf
text-color=#ffffff
default-timeout=4000

[urgency=high]
background-color=#ffffff
border-color=#ffffff
text-color=#000000
default-timeout=0
format=<span foreground="#ffffff" background="#000000"><b> %a </b></span> <b>%s</b>\n%b

[app-name="lightcord"]
border-color=#ffffff
text-color=#ffffff

[summary~="^log-.*"]
border-color=#e6e6e6
text-color=#e6e6e6

[app-name="discord"]
border-color=#d9d9d9
text-color=#ffffff

[app-name="spotify"]
border-color=#a6a6a6
text-color=#ffffff

[app-name="playerctl"]
border-color=#ffffff
text-color=#ffffff

[app-name="lightcord" summary~="(orz|ORZ|sto|STO|otl|OTL)"]
invisible=1


